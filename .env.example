# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5
LLM_FALLBACK_MODEL=
LLM_MODE=live                      # live | recorded
LLM_TIMEOUT_S=30

# --- Support agent ---
REFUND_APPROVAL_THRESHOLD=200

# --- Lineage ---
LINEAGE_API_KEY=                   # SDK -> lineage ingest key; created on first start if set
LINEAGE_REDACTION_KEY=             # HMAC secret for stable PII tokens (32+ chars)
LINEAGE_RETENTION_DAYS=30
SERVICE_TOKEN=                     # lineage <-> support-agent internal calls (32+ chars)
SESSION_SECRET=                    # signs UI session cookies (32+ chars)

# --- Admin user (created on first start) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
